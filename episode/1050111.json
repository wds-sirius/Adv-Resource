        {
            "Id": 1050111003,
            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "ああ。４年に１度のダイスターの祭典……高みを目指している役者の多くは/n世界演劇リーグの舞台に立つのが、ひとつの目標だからな。",
            "VoiceFileName": "10501110030",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 30203,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 30303,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050111004,
            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "圧巻だった。/nあれだけ完璧な演技を見せられちゃ、何も文句は言えないな。",
            "VoiceFileName": "10501110040",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050111005,
            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "だが役者として、ただ見ているだけで満足するわけにはいかないだろ？/nドイツ。",
            "VoiceFileName": "10501110050",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050111006,
            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "ああ……もちろんだ。/n今度は、私たちの番だ。",
            "VoiceFileName": "10501110060",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 17,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050111007,
            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "みんな、本番直前だが――どうか聞いてくれ。",
            "BgmFileName": "999",
            "VoiceFileName": "10501110070",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
