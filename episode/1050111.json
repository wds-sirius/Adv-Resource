            "EpisodeMasterId": 1050111,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "暦サンの演技……いつもよりも更に磨きがかかっていたな。",
            "VoiceFileName": "10501110020",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
