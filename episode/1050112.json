    "Order": 12,
    "Prev": 1050111,
    "Next": 1050113,
    "Chapter": "最終章",
    "Title": "麗しき女神の為のセプテット",
    "EpisodeDetail": [
        {
            "Id": 1050112001,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "審査員Ｄ",
            "FontSize": 2,
            "Phrase": "銀河座の公演ですね。/n安定した舞台が見られるでしょう。",
            "BackgroundImageFileName": "2220",
            "BgmFileName": "5",
            "VoiceFileName": "10501120010",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112002,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "審査員Ｅ",
            "FontSize": 2,
            "Phrase": "今年の銀河座はにわかに変化を見せた年だった。/nそれがどう転ぶか……見ものだな。",
            "VoiceFileName": "10501120020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112003,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "審査員Ｆ",
            "FontSize": 2,
            "Phrase": "……始まりますよ。",
            "VoiceFileName": "10501120030",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112004,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 4,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "205",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050112005,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『分かりました。アフロディーテ様のためとあらば。/n　このケイローン、必ずや金羊の毛皮を、あなたに献上してみせましょう』",
            "VoiceFileName": "10501120040",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112006,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『……なんということだ。私にはこの羊の気持ちが痛いほど分かる。/n　誰しもが狩られる側になどなりたくないものだ』",
            "VoiceFileName": "10501120050",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112007,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『あのように泣いている姿を見てこの弓を引くことはできない！』",
            "VoiceFileName": "10501120060",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112008,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "審査員たち",
            "FontSize": 2,
            "Phrase": "！",
            "VoiceFileName": "10501120070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112009,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "観客",
            "FontSize": 2,
            "Phrase": "（つい、観ているこっちまで感情移入してしまうような演技……）",
            "VoiceFileName": "10501120080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112010,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『なあ、金羊。お前はカルキノスについて聞いたことがあるかい？/n　かのヘラクレスに果敢に立ち向かった、勇敢な蟹だ』",
            "VoiceFileName": "10501120090",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112011,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『彼は立派なハサミを持っていてね。/n　今は夜空を輝く星として召し上げられているのだが――』",
            "VoiceFileName": "10501120100",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112012,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『星になったおかげで彼のハサミは獲物を殺さずに/n　綺麗に毛皮を刈り取ることが出来るという噂だ』",
            "VoiceFileName": "10501120110",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112013,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『カルキノスのハサミを借りれば/n　お前を傷つけずに金の羊毛だけを手に入れることができるかもしれない』",
            "VoiceFileName": "10501120120",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112014,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『さあ、カルキノスを探しに行こう！』",
            "VoiceFileName": "10501120130",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112015,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "劇団関係者",
            "FontSize": 2,
            "Phrase": "（ハイレベルな、演技、所作。これが銀河座……！/n　千寿暦が居ずとも、このレベルの舞台を！？）",
            "VoiceFileName": "10501120140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112016,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "審査員Ｄ",
            "FontSize": 2,
            "Phrase": "（近年どおりの安定した舞台……だが、/n　『色』が違う。役者ひとりひとりの動きが）",
            "VoiceFileName": "10501120150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112017,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "審査員Ｅ",
            "FontSize": 2,
            "Phrase": "（座長のラモーナ・ウォルフを中心として、/n　他の役者が動いている。支え合うかのように……）",
            "VoiceFileName": "10501120160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112018,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "審査員Ｆ",
            "FontSize": 2,
            "Phrase": "……なかなか面白いではありませんか。",
            "VoiceFileName": "10501120170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112019,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 19,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050112020,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "『なんだお前たちは？　俺に何か用か？』",
            "VoiceFileName": "10501120180",
            "CharacterMotions": [],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050112021,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『カルキノスよ、頼みごとがあるのです。/n　どうかあなたの持っているハサミを貸してはいただけないだろうか』",
            "VoiceFileName": "10501120190",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112022,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "『……ふむ。事情があるようだな。/n　とはいえ、このハサミはそう易々と人に貸せるような代物じゃない』",
            "VoiceFileName": "10501120200",
            "CharacterMotions": [],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050112023,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "『だが、だからといってここでお前が/n　この羊を殺すところをむざむざ見ているのも気分が悪い』",
            "VoiceFileName": "10501120210",
            "CharacterMotions": [],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050112024,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "『だから、俺はこれから一眠りしよう。/n　その間、お前たちがこのハサミを使って何をしようが勝手だ』",
            "VoiceFileName": "10501120220",
            "CharacterMotions": [],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050112025,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "雪",
            "FontSize": 2,
            "Phrase": "『ただし、一眠りの間だけだぞ』",
            "VoiceFileName": "10501120230",
            "CharacterMotions": [],
            "SpeakerIconId": "303"
        },
        {
            "Id": 1050112026,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『……！　感謝する、カルキノス！/n　さあ、金羊……これでお前の毛を刈り取らせてくれ』",
            "VoiceFileName": "10501120240",
            "CharacterMotions": [],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112027,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "審査員Ｆ",
            "FontSize": 2,
            "Phrase": "（座長を務める、ラモーナ・ウォルフ……。/n　演技だけでない、舞台全体を統率している……！）",
            "VoiceFileName": "10501120250",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112028,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "審査員Ｆ",
            "FontSize": 2,
            "Phrase": "（まさか、自分以外の役者の演技、その僅かな機微すらも、/n　把握しているというのか……！？　そうでなければ、説明がつかない！）",
            "VoiceFileName": "10501120260",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112029,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "審査員Ｅ",
            "FontSize": 2,
            "Phrase": "（ウォルフさん以外の役者からも、自己存在を主張するような、/n　輝かしい光が放たれていましたわね……なんて有望な子たちなのかしら）",
            "VoiceFileName": "10501120270",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112030,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 30,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050112031,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "審査員Ｄ",
            "FontSize": 2,
            "Phrase": "それでは、審査員を代表して総評を述べさせていただきます。/n……さすがは銀河座といったところでしょう。",
            "VoiceFileName": "10501120280",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112032,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "審査員Ｄ",
            "FontSize": 2,
            "Phrase": "積み上げてきた伝統に基づいた、堅実な演技は素晴らしかった。/nそして、今回の銀河座には、それ以外にも評価せねばなりません。",
            "VoiceFileName": "10501120290",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112033,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "審査員Ｄ",
            "FontSize": 2,
            "Phrase": "伝統のみに縛られず、/n常に時代の中で一番足ろうとする誇りすらも感じました。",
            "VoiceFileName": "10501120300",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050112034,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "……！　ありがとうございます！",
            "VoiceFileName": "10501120310",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "HeadMotionMasterId": 1,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 2,
