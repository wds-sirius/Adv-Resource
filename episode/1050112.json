                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
            "Id": 1050112035,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 35,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050112036,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（見事でしたわ、ラモーナさん……。/n　あなたはとうとう、成し遂げてしまったのですね）",
            "VoiceFileName": "10501120320",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 25,
                    "SpineId": 30103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050112037,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（伝統に固執せず、しかし軽んずることもなく、新たな魅せ方を築いた。/n　私の他に、違う輝きを放つ星が現れたことを示してみせたのです）",
            "VoiceFileName": "10501120330",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050112038,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（皆を率いる、新しい銀河の星とは……なんと頼もしいのでしょう。/n　この先あなたは一体、どんな未来を魅せてくださるのか――）",
            "VoiceFileName": "10501120340",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 15,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050112039,
            "EpisodeMasterId": 1050112,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "……ふふ、楽しみですわ。",
            "VoiceFileName": "10501120350",
            "CharacterMotions": [
