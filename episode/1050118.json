        {
            "Id": 1050118070,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 70,
            "SpeakerName": "望有",
            "FontSize": 2,
            "Phrase": "（あの子たちには、ただ演技を指導するだけの指導者はもう必要ない……）",
            "BackgroundCharacterImageFileName": "142510_0",
            "VoiceFileName": "10501180640",
            "CharacterMotions": [],
            "SpeakerIconId": "107"
        },
        {
            "Id": 1050118071,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 71,
            "SpeakerName": "望有",
            "FontSize": 2,
            "Phrase": "（寧ろ、必要とされているのは既にダイスターの頂の光を見た、/n　そんな役者の舞台上の背中……）",
            "BackgroundCharacterImageFileName": "142510_0",
            "VoiceFileName": "10501180650",
            "CharacterMotions": [],
            "SpeakerIconId": "107"
        },
        {
            "Id": 1050118072,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 72,
            "SpeakerName": "望有",
            "FontSize": 2,
            "Phrase": "焦がれていたこの想い……そうね、私もまだ……あの舞台に立ちたい。/nあの子たちと共に……。",
            "BackgroundCharacterImageFileName": "142510_0",
            "VoiceFileName": "10501180660",
