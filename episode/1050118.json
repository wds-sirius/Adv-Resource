{
    "EpisodeId": 1050118,
    "StoryType": 1,
    "Order": 18,
    "Prev": 1050117,
    "Next": 1050119,
    "Chapter": "最終章",
    "Title": "ネクタルの注がれる先",
    "EpisodeDetail": [
        {
            "Id": 1050118001,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "次はシリウスの公演か……。/nあの山吹シャモの作り上げた劇団がどのような輝きを見せるか見ものですね。",
            "BackgroundImageFileName": "2220",
            "BgmFileName": "5",
            "VoiceFileName": "10501180010",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118002,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "ええ、本当に。",
            "VoiceFileName": "10501180020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118003,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "何せシリウスは、それほど規模の大きな劇団ではないものの、/nダイスターを多く輩出している、伝統ある劇団ですもの。",
            "VoiceFileName": "10501180030",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118004,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "審査員Ｃ",
            "FontSize": 2,
            "Phrase": "ああ、現在も新妻八恵、/nそして昨今では舞台を離れているが、柊望有も在籍していた筈だ。",
            "VoiceFileName": "10501180040",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118005,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "となれば、ますます目が離せませんわね。",
            "VoiceFileName": "10501180050",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118006,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "……皆様、そろそろお静かに。/n幕開きですよ、シリウスの。",
            "VoiceFileName": "10501180060",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118007,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 7,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "105",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050118008,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『ふむ、確かにどの神の武勇もとても素晴らしく賞賛すべきものだが……。/n　弓矢にかけては我が妹、アルテミスの腕に敵う者はいないだろう』",
            "VoiceFileName": "10501180070",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118009,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "（まずは、アタシが魅せてあげるわ）",
            "VoiceFileName": "10501180080",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118010,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『そうだな、アルテミスの腕は狩りにおいては確かに卓越している。/n　しかし、こと戦においては、狩猟の弓は通用しない』",
            "VoiceFileName": "10501180090",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118011,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『やはり、この軍神アレースこそが、一番の弓の名手。/n　私こそが、もっとも弓を扱うに長けた神ということだっ！！』",
            "VoiceFileName": "10501180100",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118012,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "審査員Ｃ",
            "FontSize": 2,
            "Phrase": "（これは……カトリナ・グリーベルのセンスか……！/n　一場一場をしっかりと魅せられる、そんな感覚に陥る……）",
            "VoiceFileName": "10501180110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118013,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 13,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050118014,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『はっ！　お呼びでしょうか、アレース様！』",
            "VoiceFileName": "10501180120",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118015,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『お前に問いたい。/n　アルテミスとアレース、どちらがより優れた弓の名手であるか』",
            "VoiceFileName": "10501180130",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118016,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『優れていると思う方の盃へ、ネクタルを捧げよ』",
            "VoiceFileName": "10501180140",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118017,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『困りました。アルテミス様、アレース様、どちらの弓も優れています。/n　私には選ぶことなどできません』",
            "VoiceFileName": "10501180150",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118018,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『アルテミス様に注げばアレース様の機嫌を損ね、アレース様に注げば/n　きっとアポロン様の機嫌を損ねてしまう。ならばどうすれば……』",
            "VoiceFileName": "10501180160",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118019,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "（彼女は……流石知冴か。ホロスコープシーズンでは、/n　ダイスターの座こそ逃しましたが、やはり実力は確かですね）",
            "VoiceFileName": "10501180170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118020,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 20,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050118021,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『ふたりともやめてください。/n　ガニュメデスが困っているでしょう』",
            "VoiceFileName": "10501180180",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118022,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『優劣を人間に選ばせるというのなら、/n　人間の代理人を立てましょう』",
            "VoiceFileName": "10501180190",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118023,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『カストルとポリュデケウスに代理人を頼むのです。ふたりは同じ環境で育ち、/n　武勇を極め、ふたりで一つの不死を分け合う者……』",
            "VoiceFileName": "10501180200",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118024,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『これなら公平でしょう？』",
            "VoiceFileName": "10501180210",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118025,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『なるほど、それなら異論ない』",
            "VoiceFileName": "10501180220",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118026,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『そのような案を思いつくとは、さすがは私の妹だ』",
            "VoiceFileName": "10501180230",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118027,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "ぱんだ",
            "FontSize": 2,
            "Phrase": "『お任せください！』",
            "VoiceFileName": "10501180240",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1050118028,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "ぱんだ",
            "FontSize": 2,
            "Phrase": "『では的当てをして、先にカストルが当てたらアポロン様の勝ち。/n　ポリュデケウスが当てたらアレース様の勝ちとしましょうか』",
            "VoiceFileName": "10501180250",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1050118029,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "観客",
            "FontSize": 2,
            "Phrase": "（この舞台は会話のテンポが良くて、楽しいわね）",
            "VoiceFileName": "10501180260",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118030,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "ぱんだ",
            "FontSize": 2,
            "Phrase": "（観客の声的に、ここはコミカルな感じを強くするか）",
            "VoiceFileName": "10501180270",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1050118031,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "ぱんだ",
            "FontSize": 2,
            "Phrase": "『えいっ！　くそっ外したな。日差しが眩しくて上手く的に当たらない』",
            "VoiceFileName": "10501180280",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1050118032,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "ぱんだ",
            "FontSize": 2,
            "Phrase": "『今日は弦の調子が悪いみたいだ』",
            "VoiceFileName": "10501180290",
            "CharacterMotions": [],
            "SpeakerIconId": "105"
        },
        {
            "Id": 1050118033,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "（あの柳場ぱんだという役者は、/n　観客の期待感を演技に利用するのが、上手みたいね）",
            "VoiceFileName": "10501180300",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118034,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "（どの役者も、素晴らしい演技力とセンス。/n　ですが、中でも特にずば抜けているのは……鳳ここな）",
            "VoiceFileName": "10501180310",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118035,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "（彼女が共演者全てのセンスを向上させ、/n　この舞台を、より高みへと押し上げている……）",
            "VoiceFileName": "10501180320",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118036,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 36,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050118037,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『カストルとポリュデケウスの勝負なのに、なぜお前が的に当てるんだ！』",
            "VoiceFileName": "10501180330",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118038,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『真剣な勝負に水を差すとは！　けしからん！』",
            "VoiceFileName": "10501180340",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118039,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『も、申し訳ございません！　なんとお詫びすればよいか……』",
            "VoiceFileName": "10501180350",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118040,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 40,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『私がガニュメデスに加護を与えたのです』",
            "VoiceFileName": "10501180360",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118041,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 41,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『アルテミスが……！？/n　なぜだ！？　何か嫌だったというのか！？』",
            "VoiceFileName": "10501180370",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118042,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 42,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『兄さんはお前が誰にも負けない弓の使い手だと証明するために、/n　勝負をしていたんだ！　一体なぜ……！？』",
            "VoiceFileName": "10501180380",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118043,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 43,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『私が勝負してくれと頼みましたか？』",
            "VoiceFileName": "10501180390",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118044,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 44,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『そ、それは……！　だが、アレースなんかに、/n　我が妹を軽んじられたままなど……これはお前の為で……！』",
            "VoiceFileName": "10501180400",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118045,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 45,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『いい加減にしてください！』",
            "VoiceFileName": "10501180410",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118046,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 46,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『そもそも、真剣勝負だと言いますが、兄さんは太陽の陽ざしを強くして、/n　ポリュデケウスが的に当てるのを邪魔しましたよね？』",
            "VoiceFileName": "10501180420",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118047,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 47,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "『くっ！』",
            "VoiceFileName": "10501180430",
            "CharacterMotions": [],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118048,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 48,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『カストルの番の時にアレース様が勝どきを鳴らしたり、/n　カストルの弓の弦を取り替えてイカサマしたのは分かっていますよ』",
            "VoiceFileName": "10501180440",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118049,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 49,
            "SpeakerName": "カトリナ",
            "FontSize": 2,
            "Phrase": "『そ、それは……！』",
            "VoiceFileName": "10501180450",
            "CharacterMotions": [],
            "SpeakerIconId": "103"
        },
        {
            "Id": 1050118050,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 50,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『この勝負はガニュメデスの勝ちとします。/n　両者とも、それで良いですね』",
            "VoiceFileName": "10501180460",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118051,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 51,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "（この劇団で、さらに異質な存在が彼女……静香という役者。/n　鳳ここなと、似て非なる存在……）",
            "VoiceFileName": "10501180470",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118052,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 52,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050118053,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 53,
            "SpeakerName": "静香",
            "FontSize": 2,
            "Phrase": "『では、ガニュメデス、あなたにこの勝負の勝者として、/n　ネクタルを注いであげましょう』",
            "VoiceFileName": "10501180480",
            "CharacterMotions": [],
            "SpeakerIconId": "102"
        },
        {
            "Id": 1050118054,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 54,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『ありがとうございます。アルテミス様。/n　とりなしてくださって』",
            "VoiceFileName": "10501180490",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118055,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 55,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "『ごくっ……すごくさわやかです。今まで飲んだことがない味だ。/n　これが神々の喉を潤してきた……おいしい』",
            "VoiceFileName": "10501180500",
            "CharacterMotions": [],
            "SpeakerIconId": "106"
        },
        {
            "Id": 1050118056,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 56,
            "SpeakerName": "観客たち",
            "FontSize": 2,
            "Phrase": "おおおお……。",
            "VoiceFileName": "10501180510",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118057,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 57,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "鳳ここな……すごい役者だ。共演者全てのセンスを向上させながら、/n主演として卓越した演技を魅せていた。",
            "VoiceFileName": "10501180520",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118058,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 58,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "そして、静香さん。彼女が鳳さんの演技に応えるたびに、/nふたりの演技は繋がり、輝きを増していく……。",
            "VoiceFileName": "10501180530",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118059,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 59,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "流石さんは会場の空気すらも演技に組み込んでいましたね。/nこれは舞台への鋭敏な感覚を持っているがこそ、成しえた演技でしょう。",
            "VoiceFileName": "10501180540",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118060,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 60,
            "SpeakerName": "審査員Ｃ",
            "FontSize": 2,
            "Phrase": "センスもよく輝いていた。柳場ぱんだは演者と鑑賞者……、/n二つの心の声を聴いていただろう。",
            "VoiceFileName": "10501180550",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118061,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 61,
            "SpeakerName": "審査員Ｃ",
            "FontSize": 2,
            "Phrase": "台本にないセリフも舞台の完成度に寄与していた。/n……それでいて、その心の声に呑まれない確固とした演技を魅せていた。",
            "VoiceFileName": "10501180560",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118062,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 62,
            "SpeakerName": "審査員Ｂ",
            "FontSize": 2,
            "Phrase": "センスで言うのならカトリナさんも外せません。あの素晴らしい演技は、/nひとえに彼女の並外れた集中力によるものでしょう。",
            "VoiceFileName": "10501180570",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118063,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 63,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "皆さん、シリウスの舞台を観て頂き、ありがとうございました！",
            "VoiceFileName": "10501180580",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 2,
                    "SpineId": 10103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "101"
        },
        {
            "Id": 1050118064,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 64,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "舞台として全体的な完成度、各々の演技力の高さ、/nセンスも上手く組み込んだ演技プランは、見事でした。",
            "VoiceFileName": "10501180590",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118065,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 65,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "そして特に、主演の鳳さん。",
            "VoiceFileName": "10501180600",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118066,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 66,
            "SpeakerName": "審査員Ａ",
            "FontSize": 2,
            "Phrase": "あなたは、演技や演技プランを支える一本の柱になり、/n強い輝きを放っていました。素晴らしかったです。",
            "VoiceFileName": "10501180610",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050118067,
            "EpisodeMasterId": 1050118,
            "Order": 1,
            "GroupOrder": 67,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "……！/nっ……ありがとうございます！！",
            "VoiceFileName": "10501180620",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 10103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
