        {
            "Id": 1050101009,
            "EpisodeMasterId": 1050101,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "？？？",
            "FontSize": 2,
            "Phrase": "みなさん、いよいよですねっ！/n僕たちの頑張ってきた成果を、ここで魅せつけちゃいましょうっ！",
            "VoiceFileName": "10501010080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050101010,
            "EpisodeMasterId": 1050101,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "？？？",
            "FontSize": 2,
            "Phrase": "う、うん……っ、そうだね……。/nはぁ……でも、ちょっと緊張しちゃうな……。",
            "VoiceFileName": "10501010090",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
