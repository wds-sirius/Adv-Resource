            "VoiceFileName": "10501010100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050101012,
            "EpisodeMasterId": 1050101,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "？？？",
            "FontSize": 2,
            "Phrase": "そう、なんだけど……だからこそ、プレッシャーっていうか……。/n……はぁぁ～……。",
