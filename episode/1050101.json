            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050101013,
            "EpisodeMasterId": 1050101,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "？？？",
            "FontSize": 2,
            "Phrase": "わぁっ、みとちゃん！　溜息をつくと幸せが逃げちゃいますよっ！/nゆっくり息を吸って、逃げた幸せを取り戻さないと！",
            "VoiceFileName": "10501010120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
