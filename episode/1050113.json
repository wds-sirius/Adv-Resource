            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "Eden劇団員たち",
            "FontSize": 2,
            "Phrase": "はい！",
            "VoiceFileName": "10501130150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050113016,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（私が望む、最高の舞台を作る）",
            "BgmFileName": "401",
            "VoiceFileName": "10501130160",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 13,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
