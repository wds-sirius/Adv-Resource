            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "（Edenらしい舞台が誰かの心を動かすキッカケになるかもって、/n　今はアタシも信じてるよ、初魅）",
            "VoiceFileName": "10501130310",
            "CharacterMotions": [
