            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113017,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（そんな願いを抱いた当初はひとりだった。/n　誰かに自分のことを分かってもらおうとも思わなかった）",
            "VoiceFileName": "10501130170",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113018,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（だが、ひとりで走り出した道を、/n　いつからかEdenのみんながついてきてくれるようになった）",
            "VoiceFileName": "10501130180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 79,
                    "BodyMotionMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
