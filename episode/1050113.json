            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113019,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（皆が私を信じてくれている。私はその期待に応えたい）",
            "VoiceFileName": "10501130190",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 14,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
