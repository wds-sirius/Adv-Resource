            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113020,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "お前たち、覚悟はいいか？",
            "VoiceFileName": "10501130200",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
