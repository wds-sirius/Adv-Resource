            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "Eden劇団員Ｂ",
            "FontSize": 2,
            "Phrase": "問題ありません。いつでもいけます。",
            "VoiceFileName": "10501130130",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050113014,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "そうか……ご苦労だったな。/n……皆、スタッフも含めた全員だ。ここへ集まってくれ！",
            "BgmFileName": "999",
            "VoiceFileName": "10501130140",
            "CharacterMotions": [
