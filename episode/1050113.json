            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "（それでも、アタシたちは初魅についていくと決めた。/n　これはアタシたち自身の意志だ）",
            "VoiceFileName": "10501130300",
            "CharacterMotions": [
