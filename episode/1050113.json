            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113021,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "Eden劇団員たち",
            "FontSize": 2,
            "Phrase": "「もちろん！」「問題ありません！」/n「この日を待っていました！」「準備万端です！」",
            "VoiceFileName": "10501130210",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050113022,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "フフッいいだろう。/nだが、本番の前に、少し聞いてくれ。",
            "VoiceFileName": "10501130220",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 24,
                    "LipSyncMasterId": 1,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113023,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "皆の努力の甲斐もあり、この前はプロメテウス賞を受賞することが出来た。/nだがあの賞は、そもそも私たちの演劇のスタイルに合ったものと言えた。",
            "VoiceFileName": "10501130230",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113024,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "これから私たちが舞台を魅せる相手は、/nセンス至上主義の風潮を作り上げた演劇界の頂点、世界演劇リーグだ。",
            "VoiceFileName": "10501130240",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113025,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "私は現代の演劇界の主流を、変えてみせたいと思っている。",
            "VoiceFileName": "10501130250",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 17,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113026,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "だからこそ、連中の流儀に従って見せつけてやろう。/n我らが描く舞台が素晴らしいと、これこそが『舞台』だと！",
            "VoiceFileName": "10501130260",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113027,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "これより、我々は世界演劇リーグに挑戦する！",
            "VoiceFileName": "10501130270",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050113028,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "Eden劇団員たち",
            "FontSize": 2,
            "Phrase": "……！",
            "VoiceFileName": "10501130280",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050113029,
            "EpisodeMasterId": 1050113,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "（たとえその最高の舞台が、/n　世が評価するものとは相反していたとしても――）",
            "VoiceFileName": "10501130290",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 4,
                    "SpineId": 20403,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "204"
        },
        {
