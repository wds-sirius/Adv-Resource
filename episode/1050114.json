{
    "EpisodeId": 1050114,
    "StoryType": 1,
    "Order": 14,
    "Prev": 1050113,
    "Next": 1050115,
    "Chapter": "最終章",
    "Title": "忘れられた神の慟哭と飢え",
    "EpisodeDetail": [
        {
            "Id": 1050114001,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "観客たち",
            "FontSize": 2,
            "Phrase": "「次の劇団は……Eden？」「この間、欧州の賞をとったとか」/n「『忘れられた神の慟哭と飢え』……なんだか気になるタイトルね」",
            "BackgroundImageFileName": "2220",
            "BgmFileName": "5",
            "VoiceFileName": "10501140010",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114002,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "審査員Ｉ",
            "FontSize": 2,
            "Phrase": "次はEden……この劇団を率いる連尺野初魅という女性は、/n演劇界の異端児とも言えますね。",
            "VoiceFileName": "10501140020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114003,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "審査員Ｊ",
            "FontSize": 2,
            "Phrase": "ああ、だからホロスコープシーズンの際に、私からの通達を無視したのね？/nふふ……面白いけれど、見合う実力はきちんとあるのかしら？",
            "VoiceFileName": "10501140030",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114004,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "しかし、『プロメテウス賞』を受賞した実績のある劇団だ。/n私の勘だが……この劇団には、何かある。",
            "VoiceFileName": "10501140040",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114005,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "審査員Ｊ",
            "FontSize": 2,
            "Phrase": "楽しそうね。それじゃ、見せてもらうとしましょうか。/nあなたが買うほどの、輝きがあるかを。",
            "VoiceFileName": "10501140050",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114006,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 6,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "405",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050114007,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『ここは、どこだ。私は、何者だ……。/n　何も分からない。全て、忘れてしまったのか……』",
            "VoiceFileName": "10501140060",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114008,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『……そうだ、思い出した。/n　私は、自分の名前を探して旅をしていたのだ』",
            "VoiceFileName": "10501140070",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114009,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『道案内をしようか』",
            "VoiceFileName": "10501140080",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114010,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『……誰だ』",
            "VoiceFileName": "10501140090",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114011,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『牡牛座だよ。僕は君が行きたい場所を知っている。/n　安心して、かつては神の貴婦人を背中に乗せたこともあるんだ！』",
            "VoiceFileName": "10501140100",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114012,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『何故誰も彼も、私をウラヌスと呼ぶ？/n　私はそのような名前ではない。私をその名で呼ぶな！』",
            "VoiceFileName": "10501140110",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114013,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『……なんなのだ？　その名を聞くたびに、私に怒りの念が湧き上がってくる。/n　それどころか、全てを破壊したくなる……！』",
            "VoiceFileName": "10501140120",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114014,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『何故だ……私は……』",
            "VoiceFileName": "10501140130",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114015,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "観客Ａ",
            "FontSize": 2,
            "Phrase": "（主役の怒りと戸惑いの演技、こっちにまで伝わってくるみたい……！）",
            "VoiceFileName": "10501140140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114016,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "観客Ｂ",
            "FontSize": 2,
            "Phrase": "（牡牛座役も良いわ。/n　彼女の演技で、主役の悲壮感がより引き立っているもの……）",
            "VoiceFileName": "10501140150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114017,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "（…………。/n　正統的な世界演劇リーグに、このような残酷なテーマを選ぶとは）",
            "VoiceFileName": "10501140160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114018,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "（……前代未聞、としか言いようがない）",
            "VoiceFileName": "10501140170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114019,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 19,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050114020,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『私の本当の名は『凶星』……かつて名高い神だったが、/n　人々に忘れられ神格が歪んだ者の末路』",
            "VoiceFileName": "10501140180",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114021,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 21,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『数多の星を喰らう怪物……それが、私だと？　そんな……。/n　だが、確かにこの記憶は……、ああ……！　私はなんてことを……！』",
            "VoiceFileName": "10501140190",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114022,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『ここが君の居場所でないっていうのなら、探しに行こうよ』",
            "VoiceFileName": "10501140200",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114023,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『きっとどこかに、君が居ることを許される場所が、/n　ひとつくらいあるはずさ。この世界は広いんだから』",
            "VoiceFileName": "10501140210",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114024,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『さあ、顔をあげて。僕も一緒に行こう』",
            "VoiceFileName": "10501140220",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114025,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "容",
            "FontSize": 2,
            "Phrase": "『神でも、怪物ですらもなくなった……/n　君が今ここに居る理由を探すために。』",
            "VoiceFileName": "10501140230",
            "CharacterMotions": [],
            "SpeakerIconId": "204"
        },
        {
            "Id": 1050114026,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "『ああ……。/n　…………ありがとう』",
            "VoiceFileName": "10501140240",
            "CharacterMotions": [],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114027,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 27,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050114028,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 28,
            "SpeakerName": "審査員たち",
            "FontSize": 2,
            "Phrase": "……。",
            "VoiceFileName": "10501140250",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114029,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "審査員Ｊ",
            "FontSize": 2,
            "Phrase": "（先鋭的な演出と確かな演技が重厚な舞台を形作っている……、/n　あの題材でここまでの物に仕上げるなんて……正直、驚きだわ）",
            "VoiceFileName": "10501140260",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114030,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "審査員Ｉ",
            "FontSize": 2,
            "Phrase": "……一見荒唐無稽かつ残忍、途中の主役交代や与えた台本からの逸脱、/nそのような定石を崩す行為、ともすれば侮辱的とすらも取れてしまう。",
            "VoiceFileName": "10501140270",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114031,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "審査員Ｉ",
            "FontSize": 2,
            "Phrase": "けれど、評価せずにはいられない舞台でした。/nその全ての演出が緻密に練られ、役者それぞれが輝く……奇妙な瞬間だった。",
            "VoiceFileName": "10501140280",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114032,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "審査員Ｉ",
            "FontSize": 2,
            "Phrase": "正直、称賛以外の言葉が出ない……素晴らしい舞台でした。",
            "VoiceFileName": "10501140290",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114033,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "称賛の言葉、痛み入る。",
            "VoiceFileName": "10501140300",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "BodyMotionMasterId": 3,
                    "LipSyncMasterId": 1,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114034,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 34,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "だからこそ問いたい……キミはなぜ、この舞台に立ったのか？",
            "VoiceFileName": "10501140310",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114035,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "このような舞台をわざわざやることを選んだ……。/nそして舞台が、キミたちの演技は何かを訴えたいのではないか？",
            "VoiceFileName": "10501140320",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114036,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "……何かこの場で、言いたいことがあるのだろう？/n審査員代表として責任は私が負う……言ってみると良い。",
            "VoiceFileName": "10501140330",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050114037,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（流石は名優だ……お見通しというわけか）",
            "VoiceFileName": "10501140340",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 100,
                    "BodyMotionMasterId": 3,
                    "SpineId": 20103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114038,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "私は……貴方がたが作り上げた、センスを至上とした風潮に異を唱える。",
            "VoiceFileName": "10501140350",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114039,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 39,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "真の舞台というものは、演出や小道具、照明など、/n全てが役者の演技と結びつき、強く引き立て合うことでのみ完成する。",
            "VoiceFileName": "10501140360",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 74,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114040,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 40,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "センスなど、副次的な要素に過ぎない。",
            "VoiceFileName": "10501140370",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 107,
                    "BodyMotionMasterId": 21,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114041,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 41,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "貴方たちはそれを至上とする考え方を形成した……。/nそれは全ての役者にとって、ノイズとなってしまっている。",
            "VoiceFileName": "10501140380",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 73,
                    "BodyMotionMasterId": 14,
                    "LipSyncMasterId": 4,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114042,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 42,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "今、ここに我々は宣戦布告する！/n必ずや、貴方たちが作り上げた虚像を打破してみせると！",
            "VoiceFileName": "10501140390",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 101,
                    "LipSyncMasterId": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "201"
        },
        {
            "Id": 1050114043,
            "EpisodeMasterId": 1050114,
            "Order": 1,
            "GroupOrder": 43,
            "SpeakerName": "審査員Ｋ",
            "FontSize": 2,
            "Phrase": "なるほど……そうか、そう来るか。/nやはり私の勘は間違っていなかった……面白いな、キミたちは。",
            "VoiceFileName": "10501140400",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        }
    ]
}