            "EpisodeMasterId": 1050103,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "スタッフ",
            "FontSize": 2,
            "Phrase": "さて、時間ですね。/n皆さん、集まって下さい。",
            "VoiceFileName": "10501030060",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050103007,
            "EpisodeMasterId": 1050103,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "スタッフ",
            "FontSize": 2,
            "Phrase": "……ダイスターである皆さんのサポートを務めさせて頂きます。/nよろしくお願いいたします。",
            "VoiceFileName": "10501030070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050103008,
            "EpisodeMasterId": 1050103,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "スタッフ",
            "FontSize": 2,
            "Phrase": "皆さん面識はあるかと思いますが/n改めて、簡単な自己紹介から順にお願いします。",
            "VoiceFileName": "10501030080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
