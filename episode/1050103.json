            "EpisodeMasterId": 1050103,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "望有",
            "FontSize": 2,
            "Phrase": "そうよ。/n今回の課題演目である『神々の悪戯』は、神話を元にしたオリジナル脚本。",
            "VoiceFileName": "10501030200",
            "CharacterMotions": [
