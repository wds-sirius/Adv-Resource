            "GroupOrder": 5,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（自身の役を全うし、このダイスターばかりが集まる舞台の上でも、/n　必ずや輝いてみせますわ）",
            "VoiceFileName": "10501030050",
            "CharacterMotions": [
