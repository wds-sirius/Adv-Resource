            "EpisodeMasterId": 1050103,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "銀河座より参りました、千寿暦と申します。/n皆様、どうぞよろしくお願いいたします。",
            "VoiceFileName": "10501030090",
            "CharacterMotions": [
