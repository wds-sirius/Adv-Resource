            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "まさか、そこまで思って頂いているなんて思ってもみなかったので……。/nなんだか照れちゃいますね……えへへ。",
            "VoiceFileName": "1425110190",
            "CharacterMotions": [
