        {
            "Id": 142511008,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "クラスメイトA",
            "FontSize": 2,
            "Phrase": "あ、八恵ちゃん、鼻歌歌ってる！",
            "VoiceFileName": "1425110070",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511009,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "クラスメイトB",
            "FontSize": 2,
            "Phrase": "歌っていえばさ、/nこの間の『ダイスターの祭典』、テレビで観たよ！",
            "VoiceFileName": "1425110080",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511010,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "クラスメイトB",
            "FontSize": 2,
            "Phrase": "八恵ちゃんがお芝居してるところ、すっごく良かった！/n普段の八恵ちゃんと全然違って、本当にその人になりきってる感じで！",
            "VoiceFileName": "1425110090",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511011,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "クラスメイトC",
            "FontSize": 2,
            "Phrase": "それ、わたしも観たよー！　中継で生放送してたやつでしょ！",
            "VoiceFileName": "1425110100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511012,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 12,
            "SpeakerName": "クラスメイトA",
            "FontSize": 2,
            "Phrase": "えー、それなら私も観てたよ！",
            "VoiceFileName": "1425110110",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511013,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "クラスメイトC",
            "FontSize": 2,
            "Phrase": "八恵ちゃん、歌もとっても上手だったね～！",
            "VoiceFileName": "1425110120",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511014,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "まあ、本当ですか？　ありがとうございます♪/nそんな風に褒めて頂けて、光栄です。",
            "VoiceFileName": "1425110130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 10401,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "104"
        },
        {
            "Id": 142511015,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "クラスメイトA",
            "FontSize": 2,
            "Phrase": "やっぱり八恵ちゃんってダイスターなんだなぁって、改めて感じちゃったもん。/nそんなすごい子と同じ学校で、一緒のクラスなんて、一生自慢だよね～。",
            "VoiceFileName": "1425110140",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511016,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "クラスメイトC",
            "FontSize": 2,
            "Phrase": "うんうん、ほんとほんと！",
            "VoiceFileName": "1425110150",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511017,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "クラスメイトB",
            "FontSize": 2,
            "Phrase": "わたしは、八恵ちゃんがお芝居してるとこ観ながら、/nこれからもずーっとファンでいようって思ったよ！",
            "VoiceFileName": "1425110160",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511018,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 18,
            "SpeakerName": "クラスメイトA・C",
            "FontSize": 2,
            "Phrase": "分かる～！！",
            "VoiceFileName": "1425110170",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 142511019,
            "EpisodeMasterId": 142511,
            "Order": 1,
            "GroupOrder": 19,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "えっ、そう……なんですか？",
