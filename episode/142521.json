            "SpeakerIconId": "302"
        },
        {
            "Id": 142521008,
            "EpisodeMasterId": 142521,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "『世界演劇リーグ』を終えて、ようやく少し落ち着いたんだ。/n皆で楽しく鍋を囲み、互いを労うというのも悪くないだろう？",
            "VoiceFileName": "1425210080",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "302"
        },
        {
