            "SpeakerIconId": "302"
        },
        {
            "Id": 142521007,
            "EpisodeMasterId": 142521,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "もちろん火鍋はいつも通り、雪が作ってくれるぞ。/nどうだろう、良ければ暦も参加しないか？",
            "VoiceFileName": "1425210070",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
