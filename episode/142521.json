            "EpisodeMasterId": 142521,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "ならば丁度良かった！/n実はこれから、寮の皆で火鍋パーティーをしようという話になっているんだ。",
            "VoiceFileName": "1425210060",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
