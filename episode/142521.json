            "EpisodeMasterId": 142521,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "いえ……今夜は家族で食事をする約束をしているので、/n申し訳ありませんが、私は参加できそうにありませんわ。",
            "VoiceFileName": "1425210090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 71,
                    "HeadMotionMasterId": 2,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
