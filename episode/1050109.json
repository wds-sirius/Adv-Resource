            "EpisodeMasterId": 1050109,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "（あんなに奮い立つような演技のできる暦と横に立つ……/n　そんな役者になると、私は決めたんだ！）",
            "VoiceFileName": "10501090070",
            "CharacterMotions": [
