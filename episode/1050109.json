            "GroupOrder": 6,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "（だが、今度は私たちの番だ。/n　絶対に銀河座の演目を成功させなければならない）",
            "VoiceFileName": "10501090060",
            "CharacterMotions": [
