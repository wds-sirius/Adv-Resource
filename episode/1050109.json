            "EpisodeMasterId": 1050109,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "ラモーナ",
            "FontSize": 2,
            "Phrase": "さあ、気合をいれよう！/n私たちも暦の演技に見劣りしない、素晴らしい舞台を魅せるんだ！",
