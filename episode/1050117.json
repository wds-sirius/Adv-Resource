            "EpisodeMasterId": 1050117,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "ここな",
            "FontSize": 2,
            "Phrase": "私なんて、シリウスに来るまでに、オーディションに落ち続けて、/n役者になれるかどうかも分からなかった。",
            "VoiceFileName": "10501170080",
            "CharacterMotions": [
