    "Title": "そして、これからも",
    "EpisodeDetail": [
        {
            "Id": 1050120001,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 1,
            "SpeakerName": "電姫劇団員たち",
            "FontSize": 2,
            "Phrase": "「ねえねえ、もうパスポート取った？」/n「まだ～。そろそろ取んないとやばいよね」",
            "BackgroundImageFileName": "900",
            "BgmFileName": "305",
            "VoiceFileName": "10501200010",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050120002,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 2,
            "SpeakerName": "電姫劇団員たち",
            "FontSize": 2,
            "Phrase": "「英語も勉強しなきゃマズいかなー？」「え、無理ゲーすぎる」/n「もうボディランゲージで乗り切るしかないな」",
            "VoiceFileName": "10501200020",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050120003,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 3,
            "SpeakerName": "いろは",
            "FontSize": 2,
            "Phrase": "世界演劇リーグが終わって落ち着くかと思いましたけど、/n思ったよりも慌ただしくなっちゃいましたね。",
            "VoiceFileName": "10501200030",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 40103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "401"
        },
        {
            "Id": 1050120004,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "うん……でもすごいよね。色んな所から電姫のスポンサーを検討してるって、/n連絡あったらしいし……海外の劇団ともコラボ公演開催なんて……。",
            "VoiceFileName": "10501200040",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 40103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 11,
                    "LipSyncMasterId": 2,
                    "SpineId": 40203,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050120005,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "いろは",
            "FontSize": 2,
            "Phrase": "わぁ～、わくわくしちゃいますねっ！/nこんなに沢山の人たちに電姫を知って貰えたなんて……僕、感激ですっ！",
            "BackgroundImageFileName": "2251",
            "VoiceFileName": "10501200050",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
        {
            "Id": 1050120006,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "ちょっぴり不安もあるけど、でも……美兎も、/n楽しみって気持ちの方が大きいかも……。",
            "VoiceFileName": "10501200060",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050120007,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "いろは",
            "FontSize": 2,
            "Phrase": "これからも、もっとお客様に楽しんでもらえるように、/n頑張りましょうね、みとちゃん！",
            "VoiceFileName": "10501200070",
            "CharacterMotions": [],
            "SpeakerIconId": "401"
        },
        {
            "Id": 1050120008,
            "EpisodeMasterId": 1050120,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "うん……！",
            "VoiceFileName": "10501200080",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050120009,
            "EpisodeMasterId": 1050120,
