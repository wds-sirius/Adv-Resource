            "GroupOrder": 42,
            "SpeakerName": "知冴",
            "FontSize": 2,
            "Phrase": "いや～……無事に終わりましたねぇ～。",
            "VoiceFileName": "10501200380",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
