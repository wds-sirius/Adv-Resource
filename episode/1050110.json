            "Order": 1,
            "GroupOrder": 4,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "（ダイスターたちの演目ゆえ、確かに目を見張る点はあった。/n　だからこそ、負けるわけにはいかないな）",
            "VoiceFileName": "10501100040",
            "CharacterMotions": [
