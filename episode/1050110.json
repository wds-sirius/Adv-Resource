            "EpisodeMasterId": 1050110,
            "Order": 1,
            "GroupOrder": 10,
            "SpeakerName": "Eden劇団員たち",
            "FontSize": 2,
            "Phrase": "「まさか！」「私たちなら出来ますよね！」/n「Edenの舞台を魅せてやりましょう！」",
            "VoiceFileName": "10501100100",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
