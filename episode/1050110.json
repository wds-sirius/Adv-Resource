        {
            "Id": 1050110009,
            "EpisodeMasterId": 1050110,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "世界演劇リーグの、演劇界への風潮……それに異を唱えることになれば、/nあの舞台ともきっとぶつかることになる。……怖気づいたか？",
            "VoiceFileName": "10501100090",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 20101,
                    "CharacterAppearanceType": 0,
