            "EpisodeMasterId": 1050110,
            "Order": 1,
            "GroupOrder": 11,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "ふっ……皆、よく分かっているな。",
            "VoiceFileName": "10501100110",
            "CharacterMotions": [
