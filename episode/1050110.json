            "SpeakerIconId": "201"
        },
        {
            "Id": 1050110006,
            "EpisodeMasterId": 1050110,
            "Order": 1,
            "GroupOrder": 6,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "我々の目指す演劇とは似て非なるものだろう。/nしかし、あれに負けぬ舞台をして、初めて我々の舞台は認められる。",
            "VoiceFileName": "10501100060",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 24,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
