            "SpeakerIconId": "201"
        },
        {
            "Id": 1050110005,
            "EpisodeMasterId": 1050110,
            "Order": 1,
            "GroupOrder": 5,
            "SpeakerName": "初魅",
            "FontSize": 2,
            "Phrase": "皆、見ていたか？　ダイスターが作り上げる舞台。/nこれこそが頂点に近い舞台だ。",
            "VoiceFileName": "10501100050",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "BodyMotionMasterId": 15,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 3,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
