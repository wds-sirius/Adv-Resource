            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108014,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 14,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "でもね、舞台に立てることは、わくわく……してるんだ。/nいろはちゃんや電姫のみんなが、美兎の演技を褒めてくれたから……。",
            "VoiceFileName": "10501080120",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 202,
                    "BodyMotionMasterId": 13,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108015,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 15,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "みんなが好きって言ってくれた、演技で……、/nもっともっと沢山の人を笑顔にしたい……。",
            "VoiceFileName": "10501080130",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 103,
                    "BodyMotionMasterId": 4,
                    "LipSyncMasterId": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                }
            ],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108016,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 16,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "白丸さんのその想い、とても立派だと思います。",
            "VoiceFileName": "10501080140",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
