            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 8,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（ここまでやって来られたのは、/n　他の役者の皆さん、そして……いろはが側に居てくれたから）",
            "VoiceFileName": "10501080070",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
