            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 7,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（伝統ある銀河座においても、恥じぬ役者として、/n　そして今ここに、ダイスターとして、星々の中で名を連ねている……）",
            "VoiceFileName": "10501080060",
