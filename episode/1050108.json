            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 9,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "（ですから私は、この『ダイスターの祭典』という大舞台において、/n　必ずや、皆の心に残る演技を魅せてみせますわ）",
            "VoiceFileName": "10501080080",
            "CharacterMotions": [
