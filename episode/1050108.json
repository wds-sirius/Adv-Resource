            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 13,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "地歩ちゃん……！/nうん……正直言うと、まだしてる……かな。",
            "VoiceFileName": "10501080110",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "FacialExpressionMasterId": 105,
                    "BodyMotionMasterId": 20,
                    "LipSyncMasterId": 1,
                    "SpineId": 40203,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
                },
                {
                    "slotNumber": 2,
                    "SpineId": 60103,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 4,
                    "CharacterLayerType": 1,
                    "SpineSize": 2
