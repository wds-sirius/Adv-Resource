        {
            "Id": 1050108020,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 20,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "（まもなく本番を迎えます……。/n　どうか見ていてください、柊さん……）",
            "VoiceFileName": "10501080180",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
