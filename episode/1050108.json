        {
            "Id": 1050108021,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 21,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileName": "2220",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "101",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050108022,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 22,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『はあ……ヘラも悪くはないが、/n　こうして長い間一緒にいると、さすがに飽きてくるものだ』",
            "VoiceFileName": "10501080190",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108023,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 23,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『僕の冷めた心を燃え上がらせる、/n　そんな乙女が、どこかに居ないものだろうか？』",
            "VoiceFileName": "10501080200",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108024,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 24,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『……よし。気晴らしに、地上でも眺めてみるとしよう……。/n　ん？　海辺に少女が立っている？　どれどれ……』",
            "VoiceFileName": "10501080210",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108025,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 25,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『なんて麗しい乙女なんだ……！/n　場所はポセイドンの神殿、兄上のところの巫女か……？』",
            "VoiceFileName": "10501080220",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108026,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 26,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『これは作戦を考えねばな……』",
            "VoiceFileName": "10501080230",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108027,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 27,
            "SpeakerName": "審査員Ｌ",
            "FontSize": 2,
            "Phrase": "（今までにない役柄を、もう自分の物にしているとは。/n　シリウスの新妻八恵……恐ろしい成長ぶりですね）",
            "VoiceFileName": "10501080240",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108028,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 28,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "301",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050108029,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 29,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "『どうです？　神々の皆様。愉快ではありませんか？』",
            "VoiceFileName": "10501080250",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108030,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 30,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "『きっと皆様、日頃ゼウス様がやりたい放題していることに/n　思う所があるのではと思います』",
            "VoiceFileName": "10501080260",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108031,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 31,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "『どうやらゼウス様はあの少女のことを勘違いしているご様子。/n　これを利用して、ゼウス様をからかってやるのはどうでしょう？』",
            "VoiceFileName": "10501080270",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108032,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 32,
            "SpeakerName": "審査員Ｍ",
            "FontSize": 2,
            "Phrase": "（白丸美兎さん……話は聞いていたけれど、/n　憑依型の役者の中でも、表現力は群を抜いているわね。見事だわ）",
            "VoiceFileName": "10501080280",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108033,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 33,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『ほう……？　ヘルメス、君は何を企てるつもりだい？/n　詳しく教えてくれないか』",
            "VoiceFileName": "10501080290",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108034,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 34,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050108035,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 35,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『あ～～、笑った笑った！　よし、久方ぶりに弟と戯れられるんだ。/n　もちろん手を貸すさ。さて……宴会を行うということだが――』",
            "VoiceFileName": "10501080300",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108036,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 36,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『では、私が宴会場を作ろう』",
            "BackgroundCharacterImageFileName": "142520_0",
            "VoiceFileName": "10501080310",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108037,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 37,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『海よ開け！　宴の場を神々に与えるのだ！』",
            "BackgroundCharacterImageFileName": "142520_0",
            "VoiceFileName": "10501080320",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108038,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 38,
            "SpeakerName": "審査員Ｎ",
            "FontSize": 2,
            "Phrase": "（ここでも圧倒的な演技力を魅せるか……千寿暦。/n　しかも、ホロスコープシーズンから、さらに成長して……）",
            "VoiceFileName": "10501080330",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
