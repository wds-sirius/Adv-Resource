            "SpeakerIconId": "601"
        },
        {
            "Id": 1050108017,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 17,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "そして、恐らくではありますが、舞台を観て下さっている方々にも、/nその想いはきっと、伝わると思いますよ。",
            "VoiceFileName": "10501080150",
            "CharacterMotions": [
                {
                    "slotNumber": 1,
                    "SpineId": 0,
                    "CharacterAppearanceType": 0,
                    "CharacterPosition": 2,
