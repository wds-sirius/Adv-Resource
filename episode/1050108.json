        {
            "Id": 1050108040,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 40,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『ポセイドン、お前の巫女や信者たちは？/n　そろそろこの場に呼んでも良いだろう？』",
            "VoiceFileName": "10501080340",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108041,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 41,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『いやいや、我が最高神の前に出るならば、/n　最高の装いをしたいと言って聞かなくてな。もうしばらくかかりそうだ』",
            "VoiceFileName": "10501080350",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108042,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 42,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『……もう良いだろう！　早く信者や巫女たちを呼んでくれよ！/n　待ちきれない！　早く！　はーやーく！』",
            "VoiceFileName": "10501080360",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108043,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 43,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『まぁまぁ、落ち着いて。お、準備が出来たみたいだ。/n　悪かったね、ゼウス。それではみんな入ってくれ』",
            "VoiceFileName": "10501080370",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108044,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 44,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050108045,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 45,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『ああ、なんて美しいんだ！　君の美しさは他のどの女神も、/n　ニンフも、妖精すらも並ぶものは居ない！』",
            "VoiceFileName": "10501080380",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108046,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 46,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『愛しい人……どうか、僕と一緒にいてくれ』",
            "VoiceFileName": "10501080390",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108047,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 47,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "『ああ……嬉しい、ダーリン……そんなことを言ってくれるなんて……！/n　最近のあなたは、どこか冷たかったから……』",
            "VoiceFileName": "10501080400",
            "CharacterMotions": [],
            "SpeakerIconId": "601"
        },
        {
            "Id": 1050108048,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 48,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『ん？　ダーリン？？　いきなりだね……ふふっ、大胆な子は好きだよ。/n　それに最近の僕って、僕らは初対……ハッ！！！』",
            "VoiceFileName": "10501080410",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108049,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 49,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『（よく見れば、この子……僕が惚れた若い頃のヘラに瓜二つ、/n　　それに、確かここには若返りの泉があったはず……まさか）』",
            "VoiceFileName": "10501080420",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108050,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 50,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『は、ハニー……？』",
            "VoiceFileName": "10501080430",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108051,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 51,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "『ん～なぁに？　ね～、聞いてよ～。みんなね、/n　宴会が始まったのにしばらく奥にいるように言ったのよ？』",
            "VoiceFileName": "10501080440",
            "CharacterMotions": [],
            "SpeakerIconId": "601"
        },
        {
            "Id": 1050108052,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 52,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『（や、やっぱりヘラだった～～～～～！！/n　　ま、まずい……）』",
            "VoiceFileName": "10501080450",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108053,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 53,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『（浮気しようとしたことも、相手が若いヘラだったのに、/n　　全然気づかなかったことも……言えない、言えるわけがない！！）』",
            "VoiceFileName": "10501080460",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108054,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 54,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『（気づかれたら……死）』",
            "VoiceFileName": "10501080470",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108055,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 55,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "『でも、もう許したわ！　こうして、あなたがまた告白してくれる。/n　これは、そのサプライズの為の演出だったのね！』",
            "VoiceFileName": "10501080480",
            "CharacterMotions": [],
            "SpeakerIconId": "601"
        },
        {
            "Id": 1050108056,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 56,
            "SpeakerName": "八恵",
            "FontSize": 2,
            "Phrase": "『あ、ああ。当然じゃないか、マイハニー。/n　もう一度、キミへのプロポーズがしたかったんだ。迷惑だったかい？』",
            "VoiceFileName": "10501080490",
            "CharacterMotions": [],
            "SpeakerIconId": "104"
        },
        {
            "Id": 1050108057,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 57,
            "SpeakerName": "地歩",
            "FontSize": 2,
            "Phrase": "『まさか！　あんな熱い求愛……昔を思い出しちゃった。/n　ふふっ、だーい好きよ！　ダーリン！』",
            "VoiceFileName": "10501080500",
            "CharacterMotions": [],
            "SpeakerIconId": "601"
        },
        {
            "Id": 1050108058,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 58,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『くっ、ふふふ……あーはっはっはっ！　見ろ、ヘルメス。/n　ゼウスの奴、青い顔でされるがままだ！』",
            "VoiceFileName": "10501080510",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108059,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 59,
            "SpeakerName": "暦",
            "FontSize": 2,
            "Phrase": "『仲睦まじいようで、なによりだな！/n　奴にとっても良い薬になっただろう。』",
            "VoiceFileName": "10501080520",
            "CharacterMotions": [],
            "SpeakerIconId": "301"
        },
        {
            "Id": 1050108060,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 60,
            "SpeakerName": "美兎",
            "FontSize": 2,
            "Phrase": "『ぷっ、ふふふふ♪　神々の皆様もお楽しみいただけたようで恐悦至極。/n　やはり、宴会とは無礼講。愉快で幸せでなければ！』",
            "VoiceFileName": "10501080530",
            "CharacterMotions": [],
            "SpeakerIconId": "402"
        },
        {
            "Id": 1050108061,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 61,
            "FontSize": 2,
            "Phrase": "",
            "BackgroundImageFileFadeType": 1,
            "BgmFileName": "23",
            "CharacterMotions": [],
            "FadeValue1": 0.20000000298023224,
            "FadeValue2": 0.30000001192092896,
            "FadeValue3": 0.20000000298023224
        },
        {
            "Id": 1050108062,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 62,
            "SpeakerName": "審査員Ｌ",
            "FontSize": 2,
            "Phrase": "……どの役者も、ダイスターの名に相応しい、/n卓越した演技力を持っていますね。",
            "VoiceFileName": "10501080540",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108063,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 63,
            "SpeakerName": "審査員Ｌ",
            "FontSize": 2,
            "Phrase": "それは、輝かしい称号を得たばかりの頃よりも、/nさらに磨きがかかっていました。",
            "VoiceFileName": "10501080550",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108064,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 64,
            "SpeakerName": "審査員Ｍ",
            "FontSize": 2,
            "Phrase": "演技だけでない、歌声に関しても素晴らしいの一言だったわ。/n特に、新妻八恵さんの歌声は聴く者の心を強く動かしていた……。",
            "VoiceFileName": "10501080560",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108065,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 65,
            "SpeakerName": "審査員Ｎ",
            "FontSize": 2,
            "Phrase": "だがそれを踏まえて、あえてひとりの役者に言及させて貰おう。/nそれは、銀河座の千寿暦だ。",
            "VoiceFileName": "10501080570",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108066,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 66,
            "SpeakerName": "審査員Ｎ",
            "FontSize": 2,
            "Phrase": "彼女の全体としての完成度の高さは、目を見張るものがある。",
            "VoiceFileName": "10501080580",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        },
        {
            "Id": 1050108067,
            "EpisodeMasterId": 1050108,
            "Order": 1,
            "GroupOrder": 67,
            "SpeakerName": "審査員Ｌ",
            "FontSize": 2,
            "Phrase": "なるほど……私だけでなく、/n皆様、同じ意見を持たれていたようですね。",
            "VoiceFileName": "10501080590",
            "CharacterMotions": [],
            "SpeakerIconId": "1"
        }
    ]
}